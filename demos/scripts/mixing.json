{
  "id": "mixing",
  "title": "Two voices, and the mixer",
  "defaults": {
    "perform": 1.0,
    "arrive": 2.0,
    "beat": 0.7,
    "settle": 0.8,
    "hold": 3.0
  },
  "steps": [
    {
      "do": "example",
      "name": "First drone",
      "as": {
        "osc": "wcoast.complexOsc259t"
      },
      "note": "Starting again from First drone, so the rack is a clean copy of what you already know."
    },
    {
      "do": "set",
      "target": "mixer:enableA",
      "to": "off"
    },
    {
      "do": "set",
      "target": "mixer:engine",
      "to": "on"
    },
    {
      "do": "set",
      "target": "mixer:master",
      "to": 0.22,
      "perform": 1.5
    },
    {
      "do": "patch",
      "from": "osc:prinFinalOut",
      "to": "mixer:chanA",
      "note": "The drone, straight in."
    },
    {
      "do": "patch",
      "from": "osc:prinSquareOut",
      "to": "lpg:inA",
      "note": "And the plucks, through the gate."
    },
    {
      "do": "patch",
      "from": "lpg:outA",
      "to": "mixer:chanB"
    },
    {
      "do": "set",
      "target": "lpg:clkOnA",
      "to": "on"
    },
    {
      "do": "set",
      "target": "lpg:run",
      "to": "on"
    },
    {
      "do": "pause",
      "for": 3.0
    },
    {
      "do": "set",
      "target": "mixer:levelA",
      "to": 0.12,
      "perform": 4.0,
      "note": "Drone down."
    },
    {
      "do": "set",
      "target": "mixer:levelB",
      "to": 0.45,
      "perform": 3.0,
      "note": "Plucks up."
    },
    {
      "do": "pause",
      "for": 2.5
    },
    {
      "do": "set",
      "target": "mixer:enableA",
      "to": "off",
      "note": "Channel one off."
    },
    {
      "do": "pause",
      "for": 3.0
    },
    {
      "do": "set",
      "target": "mixer:enableA",
      "to": "on",
      "note": "And on again."
    },
    {
      "do": "pause",
      "for": 2.5
    }
  ]
}
