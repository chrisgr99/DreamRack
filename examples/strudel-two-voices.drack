 "settings": {
  "params": {
   "m12": {
    "code": " // A pure Strudel demo: two instruments, one pattern. `.rack(n)` says which voice\n// jack a part leaves by \u2014 V1 and V2 on the faceplate \u2014 and the cable from that jack\n// decides what plays it. Pitch travels as VOLTS, so nothing is rounded on the way in.\n// Strudel's own voices need a kit; this is the standard one.\nsamples('github:tidalcycles/dirt-samples')\n\nstack(\n  // DRUMS ON STRUDEL'S OWN VOICES. No .rack() here, so these do not go to a voice tab \u2014 superdough\n  // plays them, on the same clock as everything else.\n  s(\"bd ~ ~ bd ~ ~ ~ ~\").gain(0.75),\n  s(\"~ ~ sn ~ ~ ~ sn ~\").gain(0.5),\n  s(\"hh*8\").gain(0.22).pan(sine.fast(2).range(0.35, 0.65)),\n\n\n  // V1, the four-pole tab: eight bars in C, ending on a ii-V that hands the loop\n  // back to where it began. Four notes sharing one instant, one chord a bar.\n  note(`<[c2,g2,e3,b3] [a1,e2,c3,g3] [d2,a2,f3,c4] [g1,d2,f3,c4]\n        [c2,g2,e3,b3] [f1,c2,a2,e3] [d2,a2,f3,c4] [g1,d2,f3,b3]>`)\n    .rack(1)\n    .sustain(2.6).gain(0.4)\n    .pan(sine.slow(12).range(0.25, 0.75))\n    .timbre(sine.slow(8).range(0.25, 0.7)),\n\n  // The roots, under it, naming the filter lane in the units you already type: hertz.\n  note(\"<c1 a0 d1 g0 c1 f1 d1 g0>\").rack(1)\n    .sustain(2.2).gain(0.38).pan(0.5)\n    .lpf(perlin.slow(3).range(120, 1400)),\n\n  // V2, the brighter two-pole tab: the line, with the timbre lane climbing across\n  // the whole eight bars and dropping back at the turn. One filter sweep, played.\n  note(`<[e4 g4 b4 g4] [c5 b4 a4 e4] [f4 a4 c5 a4] [b4 a4 g4 d4]\n        [e4 g4 b4 c5] [a4 c5 e5 c5] [f4 a4 c5 a4] [b4 d5 b4 g4]>`).fast(2)\n    .rack(2)\n    .sustain(0.22).gain(0.3)\n    .pan(sine.fast(0.75).range(0.1, 0.9))\n    .timbre(saw.slow(8).range(0.15, 1)),\n\n  // And a few notes near the cadence, alternating between the two instruments.\n  note(\"<~ ~ ~ [e5 d5] ~ ~ ~ [d5 b4]>\").rack(\"<1 2>\")\n    .sustain(0.5).gain(0.22).pan(\"<0.85 0.15>\").timbre(0.85)\n\n).cpm(36)",
    "run": "off",
    "cps": 0.5,
    "window": "{\"left\": 281, \"top\": 49, \"w\": 820, \"h\": 462, \"open\": false}",
    "status": "ok"
   },
