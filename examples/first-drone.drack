{
  "format": "wcoast-patch",
  "version": 1,
  "rack": {
    "rows": 2
  },
  "mixerPos": {
    "row": 1,
    "x": 0
  },
  "modules": [
    {
      "id": "m5",
      "type": "wcoast.complexOsc259t",
      "row": 0,
