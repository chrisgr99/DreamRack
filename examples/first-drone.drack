        "modRange": "high",
        "modWave": "triangle",
        "prinFreq": 110,
        "prinFine": 0,
        "prinCvAmount": 0,
        "prinFmAmount": 0,
        "timbre": 0.45,
        "timbreCvAmount": 0,
        "order": 0.3,
        "symmetry": 0.2,
        "modIndex": 0,
        "modIndexCvAmount": 0,
        "amplMod": "off",
